# Kopieer naar .env (lokaal) of zet als variabelen in Railway
SECRET_KEY=verander-mij-in-een-lange-willekeurige-string
# Geheime delen van de links: /uitnodiging/<INVITE_TOKEN> (vrienden) en /beheer/<ADMIN_TOKEN> (beheerders)
INVITE_TOKEN=verander-mij
ADMIN_TOKEN=verander-mij-ook
# Lokaal leeg laten (SQLite). Op Railway: verwijs naar de Postgres-service, bijv. ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Zet op true zodra de app via https draait (Railway)
SECURE_COOKIES=false

# Web Push: genereer met  python scripts/generate_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optioneel
TIMEZONE=Europe/Amsterdam
NOTIFY_FROM_HOUR=9
NOTIFY_UNTIL_HOUR=21
MIN_STATS_ANSWERS=6
